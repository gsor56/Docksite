<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/page-header', { eyebrow: scope === 'platform' ? '' : 'Account', heading: 'Create account', ghost: 'register', catalogHeader: true }) %>
<section class="auth-layout page-section" data-reveal>
  <%- include('partials/auth-panel') %>
  <div class="auth-form-column">
    <% if (!ownerReady) { %>
      <%- include('partials/empty-state', { heading: 'Registration opens after the owner completes setup.', message: '', actionHref: platformUrl('/'), actionLabel: 'Back to Docksite' }) %>
    <% } else { %>
      <form method="post" action="<%= basePath %>/register" class="card stack product-card">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="label">Username<input class="input" name="username" autocomplete="username" required minlength="3" maxlength="32" pattern="[a-zA-Z0-9_-]+"></label>
        <label class="label">Email<input class="input" type="email" name="email" autocomplete="email" required maxlength="254"></label>
        <label class="label">Password<input class="input" type="password" name="password" autocomplete="new-password" required minlength="12" maxlength="72"><span class="muted">At least 12 characters; at most 72 UTF-8 bytes.</span></label>
        <label class="label">Account type<select class="input" name="account_type"><option value="contributor">Developer</option><option value="user">Personal account</option></select></label>
        <% if (scope === 'platform') { %><p class="muted">Approved developers can publish from the CMS.</p><% } %>
        <button class="btn">Create account</button>
      </form>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
