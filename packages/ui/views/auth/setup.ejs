<%- include('partials/head') %>
<%- include('partials/header') %>
<div class="form-page">
  <%- include('partials/page-header', { eyebrow: scope === 'cms' ? 'CMS' : 'Account', heading: 'Create owner account', subline: localSetup ? 'Choose your account details. This setup closes after the first owner is created.' : 'Enter the setup token from your environment file and choose your account details.', ghost: 'setup' }) %>
  <section class="page-section" data-reveal>
    <form method="post" action="<%= basePath %>/setup" class="card stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (localSetup) { %><input type="hidden" name="setup_token" value="<%= setupToken %>"><% } else { %><label class="label">Setup token<input class="input" type="password" name="setup_token" required autocomplete="off"></label><% } %>
      <label class="label">Username<input class="input" name="username" required minlength="3" maxlength="32" pattern="[a-zA-Z0-9_-]+" autocomplete="username"></label>
      <label class="label">Email<input class="input" type="email" name="email" required autocomplete="email"></label>
      <label class="label">Password<input class="input" type="password" name="password" required minlength="12" maxlength="72" autocomplete="new-password"></label>
      <button class="btn"><%= scope === 'cms' ? 'Create account and open CMS' : 'Create owner' %></button>
    </form>
  </section>
</div>
<%- include('partials/footer') %>
