<div class="nav-primary">
  <% if (scope === 'cms') { %>
    <a class="nav-link" href="<%= basePath %>/dashboard">Dashboard</a><a class="nav-link" href="<%= basePath %>/tools">Tools</a><a class="nav-link" href="<%= basePath %>/media">Media</a>
    <% if (user && ['owner', 'admin'].includes(user.role)) { %><details class="nav-overflow"><summary class="nav-link">Manage <%- include('partials/chevron') %></summary><div class="nav-dropdown"><% for (const [path,label] of [['categories','Categories'],['tags','Tags'],['submissions','Submissions'],['users','Users'],['analytics','Analytics'],['settings','Settings'],['activity','Activity'],['releases','Release notes'],['reports','Abuse reports']]) { %><a href="<%= basePath %>/<%= path %>"><%= label %></a><% } %></div></details><% } %>
    <% if (user) { %><details class="nav-overflow"><summary class="nav-link">Developer resources <%- include('partials/chevron') %></summary><div class="nav-dropdown"><a href="<%= platformUrl('/developers') %>">Developer guide</a><a href="<%= platformUrl('/docs') %>">Documentation</a><a href="<%= platformUrl('/api/docs') %>">API reference</a></div></details><% } %>
  <% } else if (scope === 'link') { %>
    <a class="nav-link" href="<%= basePath %>/">Shortener</a><% if (user) { %><a class="nav-link" href="<%= basePath %>/dashboard">My links</a><% } %><a class="nav-link" href="<%= platformUrl('/tools') %>">Directory</a>
  <% } else { %>
    <a class="nav-link" href="<%= basePath %>/tools">Tools <%- include('partials/chevron') %></a><a class="nav-link" href="<%= basePath %>/categories">Categories <%- include('partials/chevron') %></a><% if (user) { %><a class="nav-link" href="<%= basePath %>/dashboard">Dashboard</a><% } %>
  <% } %>
</div>
<div class="nav-account">
  <% if (scope === 'platform') { %><a class="nav-search" href="<%= platformUrl('/tools#tool-search') %>" aria-label="Search tools"><%- include('partials/icons', { icon: 'search' }) %></a><% } %>
  <% if (user) { %><form action="<%= basePath %>/logout" method="post" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button">Log out</button></form><% } else { %><a class="nav-link" href="<%= basePath %>/login">Login</a><% if (true) { %><a class="btn btn-secondary btn-small" href="<%= basePath %>/register">Register</a><% } %><% } %>
  <% if (scope === 'platform') { %><a class="btn btn-small" href="<%= basePath %>/build">Submit a project <%- include('partials/arrow') %></a><% } %>
</div>
