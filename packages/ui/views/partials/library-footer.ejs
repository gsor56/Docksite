<footer class="footer site-footer library-footer">
  <div class="container">
    <div class="library-footer-top">
      <div class="library-footer-brand">
        <a class="brand" href="<%= platformUrl('/') %>" aria-label="<%= platformName %> homepage"><%- logo %></a>
        <p>A directory of independent web tools, with a page for each project.</p>
      </div>
      <div class="footer-grid">
        <% for (const [group, links] of [
          ['Product', [['/tools', 'Tools'], ['/categories', 'Categories'], ['/features', 'Features'], ['/changelog', 'Changelog']]],
          ['Platform', [['/about', 'About'], ['/help', 'Help'], ['/contribute', 'Contribute'], ['/report-abuse', 'Report abuse']]],
          ['Legal', [['/legal', 'Legal and safety'], ['/privacy', 'Privacy (draft)'], ['/terms', 'Terms (draft)'], ['/accessibility', 'Accessibility']]]
        ]) { %>
          <nav class="footer-column" aria-label="<%= group %>">
            <strong><%= group %></strong>
            <% for (const [path, label] of links) { %><a href="<%= platformUrl(path) %>"><%= label %></a><% } %>
          </nav>
        <% } %>
        <nav class="footer-column" aria-label="Open source">
          <strong>Open source</strong>
          <% if (repositoryUrl) { %>
            <% const onGitHub = /^https?:\/\/(?:www\.)?github\.com\//i.test(repositoryUrl); %>
            <a class="repository-link" href="<%= repositoryUrl %>">
              <% if (onGitHub) { %><%- include('partials/github') %><% } %>
              <span><%= onGitHub ? 'MIT licensed, source on GitHub' : 'MIT-licensed source code' %></span>
            </a>
          <% } else { %>
            <span>MIT licensed</span>
          <% } %>
        </nav>
      </div>
    </div>
    <small class="library-copyright">© 2026 gsor56</small>
    <p class="footer-wordmark" aria-hidden="true"><%= platformName %></p>
  </div>
</footer>
