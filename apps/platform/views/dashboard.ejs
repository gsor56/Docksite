<%- include('partials/head') %>
<%- include('partials/header') %>
<h1>Dashboard</h1>
<p>Signed in as <strong>
<%= user.username %>
</strong> <span class="tag">
<%= user.role %>
</span>
</p>
<div class="row">
<% if (shortener) { %>
<a class="btn btn-secondary" href="<%= shortener.url + '/dashboard' %>">My short links (<%= links %>)</a>
<% } %>
<a class="btn btn-secondary" href="/build">Submit an idea</a>
<% if (['owner','admin','contributor'].includes(user.role)) { %>
<a class="btn btn-secondary" href="<%= cmsUrl('/dashboard') %>">Open CMS</a>
<% } %>
</div>
<section class="section">
<h2>My submissions</h2>
<% if (!submissions.length) { %>
<div class="empty-state">You have not submitted any tool ideas.</div>
<% } else { %>
<div class="table-wrap">
<table class="table">
<thead>
<tr>
<th>Title</th>
<th>Status</th>
<th>Review note</th>
<th>Created</th>
</tr>
</thead>
<tbody>
<% for (const submission of submissions) { %>
<tr>
<td>
<%= submission.title %>
</td>
<td>
<span class="tag">
<%= submission.status %>
</span>
</td>
<td>
<%= submission.review_note || '—' %>
</td>
<td>
<%= date(submission.created_at) %>
</td>
</tr>
<% } %>
</tbody>
</table>
</div>
<% } %>
</section>
<%- include('partials/footer') %>
