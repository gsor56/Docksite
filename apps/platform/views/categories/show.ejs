<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/page-header', { heading: category.name, subline: category.description, catalogHeader: true }) %>
<section class="page-section" data-reveal>
  <% if (!result.tools.length) { %>
    <%- include('partials/empty-state', { heading: 'No tools published in this category yet.', message: '', actionHref: '/build', actionLabel: 'Submit a tool idea' }) %>
  <% } else { %><div class="grid product-grid"><% for (const tool of result.tools) { %><%- include('partials/tool-card', { tool }) %><% } %></div><% } %>
</section>
<%- include('partials/footer') %>
