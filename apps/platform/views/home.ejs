<%- include('partials/head') %>
<%- include('partials/header') %>
<section class="hero">
<p class="eyebrow">Independent tools. Shared infrastructure.</p>
<h1>
<%= platformName %>
</h1>
<p>A directory of standalone web tools and services.</p>
<p class="metadata">
<%= total %> published <%= total === 1 ? 'tool' : 'tools' %>
</p>
<div class="row">
<a class="btn" href="/tools">Browse tools</a>
<a class="btn btn-secondary" href="/build">Submit a tool idea</a>
</div>
</section>
<section>
<div class="section-heading">
<h2>Featured tools</h2>
<a href="/tools">View directory</a>
</div>
<% if (!featured.length) { %>
<div class="empty-state">
<%= total ? 'No featured tools selected.' : 'No tools published yet.' %>
</div>
<% } else { %>
<div class="grid">
<% for (const tool of featured) { %>
<%- include('partials/tool-card', {tool}) %>
<% } %>
</div>
<% } %>
</section>
<section class="section">
<h2>Categories</h2>
<% if (!categories.length) { %>
<div class="empty-state">No categories created yet.</div>
<% } else { %>
<div class="grid">
<% for (const category of categories) { %>
<a class="card" href="/categories/<%= category.slug %>">
<%= category.name %>
<span class="metadata"> · <%= category.tool_count %> tools</span>
</a>
<% } %>
</div>
<% } %>
</section>
<section class="section">
<h2>Recently published</h2>
<% if (!recent.length) { %>
<div class="empty-state">No tools published yet.</div>
<% } else { %>
<div class="grid">
<% for (const tool of recent) { %>
<%- include('partials/tool-card', {tool}) %>
<% } %>
</div>
<% } %>
</section>
<%- include('partials/footer') %>
