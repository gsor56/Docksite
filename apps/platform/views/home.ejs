<%- include('partials/head') %>
<%- include('partials/header') %>
<section class="hero product-hero" data-reveal>
  <div class="hero-background" aria-hidden="true"><%- include('partials/subdomain-stack', { compact: false }) %></div>
  <div class="product-hero-grid">
    <div class="hero-copy">
      <h1>Small tools, each with its own address.</h1>
      <p class="hero-subline">Find independent web tools in an open-source directory.</p>
      <div class="btn-row">
        <a class="btn btn-small hero-primary" href="/tools">Browse tools <%- include('partials/arrow') %></a>
        <a class="hero-submit" href="/build">Submit a project</a>
      </div>
    </div>
    <%- include('partials/shortener-preview') %>
  </div>
</section>
<%- include('partials/popular-tools') %>
<section class="product-builder" aria-labelledby="for-builders" data-reveal>
  <div>
    <h2 id="for-builders">List a tool you built</h2>
    <p>Send a working URL for review. If approved, you can publish and edit its page in the CMS.</p>
  </div>
  <a class="btn btn-small" href="/build">Submit a project</a>
</section>
<%- include('partials/footer') %>
