<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/page-header', { eyebrow: 'URL Shortener', heading: tool.name, subline: tool.tagline, ghost: 'link' }) %>
<section class="page-section" data-reveal>
<% if (!user) { %><div class="btn-row"><a class="btn" href="<%= basePath %>/login">Login to create links <%- include('partials/arrow') %></a><a class="btn btn-secondary" href="<%= basePath %>/register">Create account</a></div><% } else { %>
<div class="section-heading"><h2>My links</h2><a class="btn" href="<%= basePath %>/links/new">Create short link <%- include('partials/arrow') %></a></div>
<% if (!links.length) { %><%- include('partials/empty-state', { heading: 'You have not created any links.', message: '', actionHref: basePath + '/links/new', actionLabel: 'Create short link' }) %><% } else { %>
<div class="table-wrap"><table class="table"><thead><tr><th>Short link</th><th>Destination</th><th>Clicks</th><th>State</th><th>Manage</th></tr></thead><tbody><% for (const link of links) { %><% const state = !link.is_active ? 'disabled' : link.expires_at && new Date(link.expires_at) <= new Date() ? 'expired' : link.click_limit && link.click_count >= link.click_limit ? 'limit reached' : 'active'; %><tr><td class="break"><a class="link-code" href="<%= basePath %>/links/<%= link.id %>"><%= shortUrl(link.code) %></a></td><td class="break"><%= link.destination_url %></td><td><%= link.click_count %><%= link.click_limit ? '/' + link.click_limit : '' %></td><td><span class="status-badge status-<%= state.replaceAll(' ', '-') %>"><%= state %></span></td><td><a href="<%= basePath %>/links/<%= link.id %>/edit">Edit</a></td></tr><% } %></tbody></table></div>
<% } %><% } %>
</section>
<%- include('partials/footer') %>
