<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/page-header', { eyebrow: '', heading: 'Submissions', ghost: 'submissions' }) %>
<div class="alert"><%= emailConfigured ? 'Review notifications use the configured SMTP sender.' : 'SMTP setup is pending. Review notifications are saved in the queue; no emails have been sent by an unconfigured sender.' %></div>
<% if (user.role === 'owner') { %><form class="inline-form" action="<%= basePath %>/submissions/send-notifications" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-secondary btn-small">Process notification queue</button></form><% } %>
<% if (!submissions.length) { %>
<%- include('partials/empty-state', { heading: 'No submissions received.', message: '', actionHref: basePath + '/submissions', actionLabel: 'Submissions' }) %>
<% } %>
<div class="stack">
<% for (const submission of submissions) { %>
<article class="card">
<h2>
<%= submission.title %>
</h2>
<p class="metadata">
<%= submission.username %> · <%= submission.status %> · <%= date(submission.created_at) %>
</p>
<% if (submission.project_url) { %><p><a href="<%= submission.project_url %>" target="_blank" rel="noopener noreferrer">Open submitted project</a></p><% } %>
<% if (submission.repository_url) { %><p><a href="<%= submission.repository_url %>" target="_blank" rel="noopener noreferrer">Repository</a></p><% } %>
<p class="metadata">Notification: <%= submission.email_status || 'No notification record' %></p>
<p class="prose">
<%= submission.idea %>
</p>
<% if (user.role === 'owner' && submission.status !== 'rejected') { %><form class="stack" method="post" action="<%= basePath %>/submissions/<%= submission.id %>/review">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<input type="hidden" name="project_url" value="<%= submission.project_url || '' %>">
<label class="label">Decision<select class="input" name="status">
<% if (submission.status === 'pending') { %><option value="approved"><%= submission.project_url ? 'Approve project for publishing' : 'Approve idea' %></option><% } %>
<option value="rejected"><%= submission.status === 'approved' ? 'Withdraw approval' : 'Reject' %></option>
</select>
</label>
<label class="label">Review note<textarea class="input" name="review_note" maxlength="2000">
<%= submission.review_note || '' %>
</textarea>
</label>
<button class="btn btn-secondary">Save review</button>
</form><% } %>
</article>
<% } %>
</div>
<div class="page-end"></div>
<%- include('partials/footer') %>
