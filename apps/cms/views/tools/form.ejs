<%- include('partials/head') %>
<%- include('partials/header') %>
<% const developer = user.role === 'contributor';
   const approved = tool?.approved_url && tool.approved_url === tool.external_url;
   const statuses = [['draft', 'Draft'], ['pending', 'Request review']];
   if (!developer || approved) statuses.push(['published', 'Published']);
   if (!developer || tool) statuses.push(['archived', 'Unpublished']); %>
<div class="form-page"><%- include('partials/page-header', { eyebrow: '', heading: tool ? 'Edit tool' : 'Create tool', ghost: 'tool' }) %>
<section class="page-section">
<form class="card stack" method="post" action="<%= basePath %>/tools<%= tool ? '/' + tool.id : '' %>">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<% for (const [name,label,max] of [['name','Name',100],['slug','Slug',60],['tagline','Tagline',180],['subdomain','Subdomain',50]]) { %>
<label class="label">
<%= label %>
<input class="input" name="<%= name %>" value="<%= tool?.[name] || '' %>" required maxlength="<%= max %>">
</label>
<% } %>
<label class="label">Landing page description<textarea class="input" name="description" required minlength="10" maxlength="12000">
<%= tool?.description || '' %>
</textarea>
</label>
<label class="label">Category<select class="input" name="category_id">
<option value="">Uncategorized</option>
<% for (const category of categories) { %>
<option value="<%= category.id %>" <%= tool?.category_id === category.id ? 'selected' : '' %>>
<%= category.name %>
</option>
<% } %>
</select>
</label>
<label class="label">Project URL<input class="input" type="url" name="external_url" value="<%= tool?.external_url || '' %>" maxlength="4096"><span class="muted">Use a working, independently hosted URL. A new URL needs owner approval.</span></label>
<label class="label">Repository URL<input class="input" type="url" name="repository_url" value="<%= tool?.repository_url || '' %>" maxlength="4096"></label>
<% if (!developer) { %><label class="label">Implementation<select class="input" name="module_key">
<option value="">Unassigned</option>
<option value="link-shortener" <%= tool?.module_key === 'link-shortener' ? 'selected' : '' %>>URL Shortener</option>
</select>
</label><% } %>
<label class="label">Status<select class="input" name="status">
<% for (const [status, label] of statuses) { %>
<option value="<%= status %>" <%= tool?.status === status ? 'selected' : '' %>>
<%= label %>
</option>
<% } %>
</select>
</label>
<label class="label">Icon<select class="input" name="icon">
<% for (const icon of ['link','box','code']) { %>
<option value="<%= icon %>" <%= tool?.icon === icon ? 'selected' : '' %>>
<%= icon %>
</option>
<% } %>
</select>
</label>
<fieldset>
<legend class="label">Tags</legend>
<% if (!tags.length) { %>
<p class="muted">No tags created.</p>
<% } %>
<% for (const tag of tags) { %>
<label class="check-label">
<input type="checkbox" name="tags" value="<%= tag.id %>" <%= tool?.tags.some(item => item.id === tag.id) ? 'checked' : '' %>>
<%= tag.name %>
</label>
<% } %>
</fieldset>
<% if (!developer) { %><label class="check-label">
<input type="checkbox" name="featured" <%= tool?.featured ? 'checked' : '' %>>Featured</label><% } %>
<button class="btn">Save tool</button>
</form>
</section></div>
<%- include('partials/footer') %>
