<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/page-header', { eyebrow: 'Tool #' + tool.id, heading: tool.name, ghost: 'tool' }) %>
<span class="tag">
<%= tool.status %>
</span>
<p>
<%= tool.tagline %>
</p>
<div class="prose">
<%= tool.description %>
</div>
<p class="metadata break">Tool address: <code><%= toolAddress %></code> · Updated <%= date(tool.updated_at) %>
</p>
<% if (tool.status === 'draft' && tool.approved_url && tool.approved_url === tool.external_url) { %>
<p class="muted">Approved. Edit the landing page or publish it to the directory.</p>
<% } %>
<div class="row">
<a class="btn" href="<%= basePath %>/tools/<%= tool.id %>/edit">Edit landing page</a>
<% if (['draft','archived'].includes(tool.status) && tool.approved_url && tool.approved_url === tool.external_url) { %>
<form method="post" action="<%= basePath %>/tools/<%= tool.id %>/publish">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button class="btn">Publish tool</button>
</form>
<% } %>
<% if (tool.status === 'published') { %>
<a class="btn btn-secondary" href="<%= toolAddress %>">Open tool</a>
<a href="<%= platformUrl('/tools/' + tool.slug) %>">Public page</a>
<% } %>
<% if (tool.status === 'published') { %>
<form method="post" action="<%= basePath %>/tools/<%= tool.id %>/archive" data-confirm="Remove this tool from the public directory?">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button class="btn btn-secondary">Unpublish</button>
</form>
<% } %>
<form method="post" action="<%= basePath %>/tools/<%= tool.id %>/delete" data-confirm="Delete this tool? Tools with link records must be archived instead.">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button class="btn btn-secondary danger">Delete</button>
</form>
</div>
<div class="page-end"></div>
<%- include('partials/footer') %>
