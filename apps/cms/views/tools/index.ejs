<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/page-header', { eyebrow: '', heading: 'Tools', ghost: 'tools' }) %>
<p><a class="btn" href="<%= basePath %>/tools/new">Create tool</a></p>
<% if (!tools.length) { %>
<%- include('partials/empty-state', { heading: 'No tools created yet. The URL Shortener module is implemented and can be registered here.', message: '', actionHref: basePath + '/tools/new', actionLabel: 'Create tool' }) %>
<% } else { %>
<div class="table-wrap">
<table class="table">
<thead>
<tr>
<th>Name</th>
<th>Slug</th>
<th>Status</th>
<th>Subdomain</th>
<th>Updated</th>
</tr>
</thead>
<tbody>
<% for (const tool of tools) { %>
<tr>
<td>
<a href="<%= basePath %>/tools/<%= tool.id %>">
<%= tool.name %>
</a>
</td>
<td>
<code>
<%= tool.slug %>
</code>
</td>
<td>
<span class="status-badge status-<%= tool.status %>">
<%= tool.status %>
</span>
</td>
<td>
<code>
<%= tool.subdomain %>
</code>
</td>
<td>
<%= date(tool.updated_at) %>
</td>
</tr>
<% } %>
</tbody>
</table>
</div>
<% } %>
<div class="page-end"></div>
<%- include('partials/footer') %>
