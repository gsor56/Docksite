<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/page-header', { heading: user.role === 'contributor' ? 'My tools' : 'Tools', ghost: 'tools' }) %>
<% if (tools.length) { %><p><a class="btn" href="<%= basePath %>/tools/new">Add tool</a></p><% } %>
<% if (!tools.length) { %>
<%- include('partials/empty-state', { heading: 'No tools yet.', message: '', actionHref: basePath + '/tools/new', actionLabel: 'Add tool' }) %>
<% } else { %>
<div class="table-wrap">
<table class="table">
<thead>
<tr>
<th>Name</th>
<th>Slug</th>
<th>Status</th>
<th>Subdomain</th>
<th>Updated</th>
</tr>
</thead>
<tbody>
<% for (const tool of tools) { %>
<tr>
<td>
<a href="<%= basePath %>/tools/<%= tool.id %>">
<%= tool.name %>
</a>
</td>
<td>
<code>
<%= tool.slug %>
</code>
</td>
<td>
<span class="status-badge status-<%= tool.status %>">
<%= tool.status %>
</span>
<% if (tool.status === 'draft' && tool.approved_url && tool.approved_url === tool.external_url) { %><span class="metadata">Ready to publish</span><% } %>
</td>
<td>
<code>
<%= tool.subdomain %>
</code>
</td>
<td>
<%= date(tool.updated_at) %>
</td>
</tr>
<% } %>
</tbody>
</table>
</div>
<% } %>
<div class="page-end"></div>
<%- include('partials/footer') %>
