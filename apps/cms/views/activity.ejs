<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/page-header', { eyebrow: '', heading: 'Activity log', ghost: 'activity' }) %>
<p class="muted">Latest 200 administrative actions.</p>
<% if (!entries.length) { %>
<%- include('partials/empty-state', { heading: 'No activity recorded.', message: '', actionHref: basePath + '/dashboard', actionLabel: 'Dashboard' }) %>
<% } else { %>
<div class="table-wrap">
<table class="table">
<thead>
<tr>
<th>Actor</th>
<th>Action</th>
<th>Entity</th>
<th>Metadata</th>
<th>Time</th>
</tr>
</thead>
<tbody>
<% for (const entry of entries) { %>
<tr>
<td>
<%= entry.username || 'Deleted account' %>
</td>
<td>
<code>
<%= entry.action %>
</code>
</td>
<td>
<%= entry.entity_type %> #<%= entry.entity_id || '—' %>
</td>
<td class="break">
<code>
<%= entry.metadata %>
</code>
</td>
<td class="metadata">
<%= entry.created_at %>
</td>
</tr>
<% } %>
</tbody>
</table>
</div>
<% } %>
<div class="page-end"></div>
<%- include('partials/footer') %>
