<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/page-header', { eyebrow: '', heading: 'Dashboard', ghost: 'cms' }) %>
<div class="grid">
<% for (const [key,value] of Object.entries(counts)) { if (value !== null) { %>
<a class="card" href="<%= basePath %>/<%= key %>">
<h2>
<%= key %>
</h2>
<p class="metadata">
<span class="record-count"><%= value %></span> records</p>
</a>
<% } } %>
</div>
<p class="section">
<a class="btn" href="<%= basePath %>/tools/new">Create tool</a>
</p>
<div class="page-end"></div>
<%- include('partials/footer') %>
