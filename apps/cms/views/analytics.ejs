<%- include('partials/head') %>
<%- include('partials/header') %>
<%- include('partials/page-header', { eyebrow: '', heading: 'Analytics', ghost: 'analytics' }) %>
<div class="row">
<% for (const total of totals) { %>
<span class="tag">
<%= total.event %>: <%= total.total %>
</span>
<% } %>
</div>
<p class="muted">Latest 200 events. Popularity counts real use events, including link creation and redirects.</p>
<% if (!events.length) { %>
<%- include('partials/empty-state', { heading: 'No analytics events recorded.', message: '', actionHref: basePath + '/dashboard', actionLabel: 'Dashboard' }) %>
<% } else { %>
<div class="table-wrap">
<table class="table">
<thead>
<tr>
<th>Event</th>
<th>Tool</th>
<th>Metadata</th>
<th>Time</th>
</tr>
</thead>
<tbody>
<% for (const event of events) { %>
<tr>
<td>
<%= event.event %>
</td>
<td>
<%= event.tool_name || 'Platform' %>
</td>
<td class="break">
<code>
<%= event.metadata %>
</code>
</td>
<td class="metadata">
<%= event.created_at %>
</td>
</tr>
<% } %>
</tbody>
</table>
</div>
<% } %>
<div class="page-end"></div>
<%- include('partials/footer') %>
