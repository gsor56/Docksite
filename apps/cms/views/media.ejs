<%- include('partials/head') %>
<%- include('partials/header') %>
<h1>Media</h1>
<p class="metadata">PNG, JPEG, GIF, WebP · Maximum <%= Math.floor(maxBytes / 1048576) %> MB</p>
<form class="card stack narrow" method="post" action="<%= basePath %>/media" enctype="multipart/form-data">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label class="label">Image<input class="input" type="file" name="file" accept="image/png,image/jpeg,image/gif,image/webp" data-maximum="<%= maxBytes %>" required>
</label>
<label class="label">Tool<select class="input" name="tool_id">
<option value="">Unattached</option>
<% for (const tool of tools) { %>
<option value="<%= tool.id %>">
<%= tool.name %>
</option>
<% } %>
</select>
</label>
<label class="label">Expiry (UTC)<input class="input" type="datetime-local" name="expires_at">
</label>
<button class="btn">Upload</button>
</form>
<section class="section">
<% if (!media.length) { %>
<div class="empty-state">No media uploaded.</div>
<% } else { %>
<div class="grid">
<% for (const item of media) { %>
<article class="card">
<% if (!item.expires_at || new Date(item.expires_at) > new Date()) { %>
<img class="media-preview" src="<%= basePath %>/media/<%= item.id %>/file" alt="<%= item.original_name %>" loading="lazy">
<% } %>
<p class="break">
<%= item.original_name %>
</p>
<p class="metadata">
<%= item.mime_type %> · <%= item.size %> bytes<br>Owner: <%= item.username %>
<br>Expiry: <%= item.expires_at || 'None' %>
</p>
<form method="post" action="<%= basePath %>/media/<%= item.id %>/delete" data-confirm="Delete this file?">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button class="btn btn-secondary danger">Delete</button>
</form>
</article>
<% } %>
</div>
<% } %>
</section>
<script src="<%= basePath %>/assets/media.js" defer>
</script>
<%- include('partials/footer') %>
